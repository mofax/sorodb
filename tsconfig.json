{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": false,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src/**/*.js", "examples/**/*.js", "test/**/*.js"]
}
